{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BIPRemote Stream Events v1",
  "type": "object",
  "description": "Eventos de stream para transmissão de vídeo e áudio remota",
  "typeDefinition": "openapi3",
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "stream.start",
        "stream.frame",
        "stream.audio",
        "stream.stop",
        "stream.error"
      ],
      "description": "Tipo de evento de stream"
    },
    "schema_version": {
      "type": "string",
      "const": "v1",
      "description": "Versão do schema do evento"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid",
      "description": "ID de correlação para rastreamento distribuído"
    },
    "session_id": {
      "type": "string",
      "format": "uuid",
      "description": "ID da sessão associada"
    },
    "frame_data": {
      "type": "string",
      "format": "base64",
      "description": "Dados do frame de vídeo codificado (base64)"
    },
    "frame_width": {
      "type": "integer",
      "minimum": 1,
      "description": "Largura do frame em pixels"
    },
    "frame_height": {
      "type": "integer",
      "minimum": 1,
      "description": "Altura do frame em pixels"
    },
    "frame_rate": {
      "type": "number",
      "minimum": 0,
      "description": "Taxa de frames por segundo"
    },
    "audio_data": {
      "type": "string",
      "format": "base64",
      "description": "Dados de áudio codificados (base64)"
    },
    "audio_sample_rate": {
      "type": "integer",
      "minimum": 8000,
      "description": "Taxa de amostragem de áudio em Hz"
    },
    "audio_channels": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2,
      "description": "Número de canais de áudio"
    }
  },
  "required": ["event_type", "schema_version", "correlation_id", "session_id"],
  "oneOf": [
    { "properties": { "frame_data": true } },
    { "properties": { "audio_data": true } }
  ],
  "additionalProperties": false
}